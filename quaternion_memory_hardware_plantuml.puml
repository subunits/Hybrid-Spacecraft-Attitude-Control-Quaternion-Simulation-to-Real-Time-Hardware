@startuml quaternion_memory_hardware_classes
!theme plain
skinparam backgroundColor #ffffff
skinparam classBackgroundColor #f3e5f5
skinparam classBorderColor #7b1fa2
skinparam arrowColor #7b1fa2

title Quaternion Memory Hardware\nFPGA-Embedded C Codesign Architecture

package "FPGA Hardware Layer (Verilog)" {
  class QuaternionMemoryBank_Controller {
    + clk: Logic
    + rst_n: Logic
    + ctrl_save: Logic
    + q_scalar: 32-bit Float
    + q_x, q_y, q_z: 32-bit Float
    + angle: 32-bit Float
    + read_addr: 10-bit
    --
    + r_scalar, r_x, r_y, r_z, r_angle
    + snapshot_count: 16-bit
    + busy_flag: Logic
    --
    States: IDLE, SAVE, OUTPUT
    Auto-increments write_addr (wrap 1023)
  }

  class BRAM_Storage {
    + mem_scalar: 1024 x 32b
    + mem_x: 1024 x 32b
    + mem_y: 1024 x 32b
    + mem_z: 1024 x 32b
    + mem_angle: 1024 x 32b
  }

  class Testbench {
    + tb_QuaternionMemoryBank.v
    --
    + simulates write/read loops
    + generates VCD waveforms
  }

  QuaternionMemoryBank_Controller --> BRAM_Storage : stores data
  Testbench --> QuaternionMemoryBank_Controller : stimulates
}

package "Hardware Abstraction Layer" {
  class MMIO_Registers {
    + CTRL_REG
    + STATUS_REG
    + SNAPSHOT_SEL
    + Write/Read address pointers
  }
}

package "Embedded C Driver Layer" {
  class SimulatedHardwareBank {
    + uint32_t CTRL_REG
    + uint32_t STATUS_REG
    + uint32_t Q_SCALAR, Q_X, Q_Y, Q_Z, ANGLE_REG
    + uint32_t R_SCALAR, R_X, R_Y, R_Z, R_ANGLE
    + uint16_t SNAPSHOT_COUNT
  }

  class DriverAPI {
    + q_bank_add(s, x, y, z, angle): bool
    + q_bank_read(index, *s, *x, *y, *z, *angle): void
  }

  class MainDriver {
    + main()
  }

  DriverAPI --> SimulatedHardwareBank : uses
  MainDriver --> DriverAPI : calls
}

SimulatedHardwareBank --> MMIO_Registers : maps
BRAM_Storage --> MMIO_Registers : synthesizes

@enduml
